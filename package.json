{
  "name": "harness-learning",
  "version": "0.0.0",
  "private": true,
  "description": "Building a coding agent harness from scratch, one step at a time.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @harness/dev-server --filter @harness/web run dev",
    "dev:server": "pnpm --filter @harness/dev-server run dev",
    "dev:web": "pnpm --filter @harness/web run dev",
    "build": "pnpm --filter @harness/web run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && pnpm --filter @harness/web run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
      "oxlint --fix --max-warnings 0 --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,yaml,yml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.20.0"
}
