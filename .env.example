# Copy to .env and fill in. .env is git-ignored; this file is not, so never
# put a real key here.
#
#   cp .env.example .env
#
# Anything already set in the shell wins over anything written here.

# Set this to talk to a real provider. Leave it out for the scripted adapter,
# which streams a canned reply with no key and no network.
HARNESS_API_KEY=

# Model id. Required when a key is set; the harness never guesses one.
# e.g. gpt-4o-mini, deepseek-chat, moonshot-v1-8k, qwen-plus
HARNESS_MODEL=

# API root of any provider that speaks OpenAI chat-completions.
# Defaults to https://api.openai.com/v1 when unset.
# e.g. https://api.deepseek.com/v1
HARNESS_BASE_URL=

# How hard the model should think before answering. The harness accepts the
# documented superset — none, minimal, low, medium, high, xhigh, max — because
# providers document different subsets of it and only the provider knows which.
# Unset leaves it to the provider's default. Reasoning models emit their working
# as `assistant/reasoning` events, which are journalled but never sent back.
# HARNESS_REASONING=high

# Whether the model reasons at all: enabled or disabled. A switch, not a dial —
# use HARNESS_REASONING for the dial. Unset lets the model decide, which for a
# reasoning model means it reasons.
# HARNESS_THINKING=enabled

# Milliseconds between scripted deltas. Only used without a key. Defaults to 40.
# HARNESS_SCRIPT_DELAY_MS=40

# Where session journals live. One file per session, named by its id.
# Defaults to .harness/sessions.
# HARNESS_SESSIONS=.harness/sessions

# Start attached to a session that already exists, instead of a new one.
# Unset — the normal case — starts a fresh session and leaves the older ones on
# the shelf until something asks for one by name.
# HARNESS_SESSION=20260823-074139-k3f9

# Port the dev server listens on. Defaults to 8787.
# PORT=8787
